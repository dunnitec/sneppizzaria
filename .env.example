# Copie para .env (que nunca vai para o Git) e ajuste.
FLASK_APP=run.py

# Em produção (APP_ENV=production) a aplicação não sobe sem uma SECRET_KEY própria.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
# APP_ENV=production
# SECRET_KEY=

# Banco de dados. Sem esta linha, usa o arquivo local snep.db (SQLite).
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/snep_pizzaria

# Slug do tenant padrão usado na home "/"
DEFAULT_TENANT_SLUG=snep
